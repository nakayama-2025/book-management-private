<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stocker - 在庫管理システム</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <script src="https://unpkg.com/papaparse@5.4.1/papaparse.min.js"></script>
    <style>
        :root {
            --primary: #4F46E5; --primary-hover: #4338ca; --bg-body: #F3F4F6; --bg-surface: #FFFFFF;
            --text-main: #1F2937; --text-muted: #6B7280; --border: #E5E7EB;
            --status-ok: #10B981; --status-warn: #F59E0B; --status-crit: #EF4444;
            --area-a: #3B82F6; --area-b: #10B981; --area-c: #EAB308; --area-d: #F97316;
            --area-e: #C084FC; --area-f: #06B6D4; --area-g: #EC4899; --area-h: #2563EB;
            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05); --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1);
            --radius: 12px;
        }

        * { box-sizing: border-box; }
        body { font-family: 'Inter', 'Noto Sans JP', sans-serif; margin: 0; background-color: var(--bg-body); color: var(--text-main); height: 100vh; overflow: hidden; }
        #app { display: flex; height: 100%; opacity: 0.3; pointer-events: none; transition: opacity 0.3s; }
        #app.authenticated { opacity: 1; pointer-events: auto; }

        /* Sidebar & Layout */
        .sidebar { width: 260px; background: var(--bg-surface); border-right: 1px solid var(--border); display: flex; flex-direction: column; padding: 1.5rem; display: none; }
        @media(min-width: 768px) { .sidebar { display: flex; } .bottom-nav { display: none !important; } }
        .main-content { flex: 1; overflow-y: auto; position: relative; padding-bottom: 80px; }
        .view { display: none; padding: 1.5rem; max-width: 1200px; margin: 0 auto; }
        .view.active { display: block; }

        /* Tables */
        .table-container { background: var(--bg-surface); border-radius: var(--radius); box-shadow: var(--shadow-sm); overflow-x: auto; max-height: 70vh; }
        table { width: 100%; border-collapse: collapse; white-space: nowrap; }
        th { text-align: left; padding: 1rem; color: var(--text-muted); font-weight: 500; border-bottom: 1px solid var(--border); position: sticky; top: 0; background: white; z-index: 10; }
        td { padding: 1rem; border-bottom: 1px solid var(--border); }

        /* Login Modal */
        #loginModal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #F3F4F6; z-index: 9999; display: flex; justify-content: center; align-items: center; }
        #loginModal.hidden { display: none; }
        .login-card { background: white; padding: 2.5rem; border-radius: 16px; box-shadow: var(--shadow-md); width: 90%; max-width: 360px; text-align: center; }
        .login-input { width: 100%; padding: 1rem; border: 1px solid var(--border); border-radius: 8px; font-size: 1.2rem; text-align: center; letter-spacing: 0.5rem; margin-bottom: 1.5rem; }

        /* Other UI components */
        .search-panel { background: var(--bg-surface); padding: 1rem; border-radius: var(--radius); margin-bottom: 1.5rem; display: flex; gap: 1rem; flex-wrap: wrap; }
        .btn-primary { background: var(--primary); color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 8px; font-weight: 600; cursor: pointer; }
        .loading-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,255,255,0.7); z-index: 9000; display: none; justify-content: center; align-items: center; }
        .loading-overlay.active { display: flex; }
    </style>
</head>

<body>

    <!-- ログインモーダル -->
    <div id="loginModal">
        <div class="login-card">
            <h2 style="color: var(--primary); margin-top: 0;">Stocker Login</h2>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 2rem;">パスワードを入力してください</p>
            <input type="password" id="loginPass" class="login-input" placeholder="****" onkeypress="if(event.key==='Enter') checkLogin()">
            <button class="btn-primary" style="width: 100%;" onclick="checkLogin()">ログイン</button>
        </div>
    </div>

    <!-- メインアプリ -->
    <div id="app">
        <aside class="sidebar">
            <div class="brand" style="font-size: 1.5rem; font-weight: 700; color: var(--primary); margin-bottom: 2rem; display: flex; align-items: center; gap: 0.5rem;">
                <ion-icon name="cube"></ion-icon><span>Stocker</span>
            </div>
            <nav style="display: flex; flex-direction: column; gap: 0.5rem;">
                <button class="nav-item active" onclick="router('dashboard')">在庫一覧</button>
                <button class="nav-item" onclick="router('register')">入庫・登録</button>
                <button class="nav-item" onclick="router('logs')">操作ログ</button>
            </nav>
        </aside>

        <main class="main-content">
            <!-- 在庫一覧ビュー -->
            <section id="view-dashboard" class="view active">
                <header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                    <h1>在庫検索</h1>
                    <button class="btn-primary" onclick="refreshData()"><ion-icon name="refresh"></ion-icon></button>
                </header>

                <div class="search-panel">
                    <input type="text" id="searchInput" placeholder="名称、ID、ISBNで検索..." style="flex: 1; padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border);" onkeyup="filterItems()">
                </div>

                <div class="table-container">
                    <table id="inventoryTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>場所</th>
                                <th>名称</th>
                                <th>数量</th>
                                <th>種別</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody><!-- JSで動的生成 --></tbody>
                    </table>
                </div>
            </section>

            <!-- 操作ログビュー -->
            <section id="view-logs" class="view">
                <h1>操作ログ</h1>
                <div class="table-container">
                    <table id="logsTable">
                        <thead>
                            <tr>
                                <th>日時</th>
                                <th>操作内容</th>
                                <th>対象書籍名</th>
                                <th>数量</th>
                                <th>操作者</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>

    <div id="loadingOverlay" class="loading-overlay"><div>Loading...</div></div>

    <script>
        /**
         * 1. 設定・状態管理
         */
        const CONFIG = {
            USE_REAL_API: true,
            // ↓ ここに最新のURLが定義されています
            GAS_WEB_APP_URL: "https://script.google.com/macros/s/AKfycbzymB9lco_JkhGR3DyF9qsKks_suS6Px2zK_pxeZ0-0pJMRvM0c-FEhOJ0ipBAPKO6z/exec"
        };

        let appState = {
            inventory: [],
            logs: [],
            authenticated: false,
            currentView: 'dashboard'
        };

        /**
         * 2. APIクラス (通信の要)
         */
        class API {
            static getUrl() {
                return CONFIG.GAS_WEB_APP_URL;
            }

            // データ取得 (GET)
            static async getData() {
                if (!CONFIG.USE_REAL_API) return { status: 'success', data: { inventory: [] } };
                
                const url = `${this.getUrl()}?action=getInventory`;
                try {
                    const res = await fetch(url, {
                        method: 'GET',
                        redirect: 'follow' // GASのリダイレクトに必須
                    });
                    if (!res.ok) throw new Error("Network response was not ok");
                    return await res.json();
                } catch (err) {
                    console.error("API Fetch Error:", err);
                    return { status: 'error', message: err.toString() };
                }
            }

            // データ更新 (POST)
            static async post(action, payload) {
                const url = this.getUrl();
                try {
                    const res = await fetch(url, {
                        method: 'POST',
                        redirect: 'follow',
                        body: JSON.stringify({ action: action, payload: payload }),
                        headers: { 'Content-Type': 'text/plain;charset=utf-8' } // CORS回避のため text/plain
                    });
                    return await res.json();
                } catch (err) {
                    console.error("API Post Error:", err);
                    return { status: 'error' };
                }
            }
        }

        /**
         * 3. 認証ロジック
         */
        function checkLogin() {
            const pass = document.getElementById('loginPass').value;
            if (pass === 'toyoplan995') {
                appState.authenticated = true;
                localStorage.setItem('stocker_auth', 'true');
                document.getElementById('loginModal').classList.add('hidden');
                document.getElementById('app').classList.add('authenticated');
                refreshData(); // ログイン成功後にデータを読み込む
            } else {
                alert('パスワードが違います');
            }
        }

        /**
         * 4. UI制御
         */
        async function refreshData() {
            if (!appState.authenticated) return;
            toggleLoading(true);
            const res = await API.getData();
            if (res.status === 'success') {
                appState.inventory = res.data.inventory || [];
                renderTable();
            } else {
                alert("データの読み込みに失敗しました: " + (res.message || ""));
            }
            toggleLoading(false);
        }

        function renderTable() {
            const tbody = document.querySelector('#inventoryTable tbody');
            tbody.innerHTML = '';
            appState.inventory.forEach(item => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${item.id}</td>
                    <td>${item.area}-${item.shelf}-${item.column}</td>
                    <td>${item.name}</td>
                    <td>${item.qty}</td>
                    <td>${item.type}</td>
                    <td><button onclick="alert('詳細/編集機能')">編集</button></td>
                `;
                tbody.appendChild(tr);
            });
        }

        function router(view) {
            document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
            document.getElementById(`view-${view}`).classList.add('active');
            appState.currentView = view;
        }

        function toggleLoading(show) {
            document.getElementById('loadingOverlay').classList.toggle('active', show);
        }

        // 初期化
        window.onload = () => {
            if (localStorage.getItem('stocker_auth') === 'true') {
                document.getElementById('loginPass').value = 'toyoplan995';
                checkLogin();
            }
        };
    </script>
</body>
</html>
