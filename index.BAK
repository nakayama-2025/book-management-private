            function initPaperSelect() {
                const nameSelect = document.getElementById('paperNameSelect');
                // Unique names
                const names = [...new Set(PAPER_MASTER_RAW.map(row => row[0]))];
                names.forEach(n => {
                    const op = document.createElement('option');
                    op.value = n;
                    op.textContent = n;
                    nameSelect.appendChild(op);
                });
            }

            function addNewPaperMaster() {
                const newName = prompt("新しい用紙名を入力してください:");
                if (newName) {
                    // Add dummy entry to master for now
                    PAPER_MASTER_RAW.push([newName, "-", "-", "-"]);
                    initPaperSelect(); // Refresh
                    // Select the new one
                    document.getElementById('paperNameSelect').value = newName;
                    updatePaperSpecs();
                }
            }

            function updatePaperSpecs() {
                const name = document.getElementById('paperNameSelect').value;
                const specSelect = document.getElementById('paperSpecSelect');
                specSelect.innerHTML = '<option value="">-</option>';

                if (!name) return;

                const relevant = PAPER_MASTER_RAW.filter(r => r[0] === name);
                relevant.forEach((r, idx) => {
                    const op = document.createElement('option');
                    // Value works as index in the relevant array
                    op.value = idx;
                    const sizeShort = r[1].split(/[（(]/)[0]; // simple display
                    op.textContent = `${r[1]} / ${r[2]}`;
                    specSelect.appendChild(op);
                });
            }

            function fillPaperData() {
                const name = document.getElementById('paperNameSelect').value;
                const specIdx = document.getElementById('paperSpecSelect').value;
                if (!name || specIdx === "") return;

                const row = PAPER_MASTER_RAW.filter(r => r[0] === name)[parseInt(specIdx)];

                document.getElementById('regName').value = `${row[0]} ${row[2]}`;
                document.getElementById('regSize').value = row[1];

                // Auto-fill memo with packaging info if available
                const pack = row[3];
                if (pack && pack !== '-') {
                    const currentMemo = document.getElementById('regMemo').value;
                    if (!currentMemo.includes(pack)) {
                        document.getElementById('regMemo').value = (currentMemo ? currentMemo + '\n' : '') + `梱包: ${pack}`;
                    }
                }
            }

            function handleTypeChange() {
                const type = document.getElementById('regType').value;

                // Toggle Paper Selection
                const paperContainer = document.getElementById('paperSelectContainer');
                if (type === '用紙') {
                    paperContainer.style.display = 'block';
                    if (document.getElementById('paperNameSelect').options.length <= 1) initPaperSelect();
                } else {
                    paperContainer.style.display = 'none';
                    // Clear if hidden? Maybe not, to allow undo.
                }

                // Toggle Image Upload (Books) & ISBN & BookID
                const imageContainer = document.getElementById('imageUploadContainer');
                const isbnContainer = document.getElementById('isbnInputContainer');
                const bookIdContainer = document.getElementById('bookIdInputContainer');

                if (type === '書籍') {
                    imageContainer.style.display = 'block';
                    isbnContainer.style.display = 'block';
                    if (bookIdContainer) bookIdContainer.style.display = 'block';
                } else {
                    imageContainer.style.display = 'none';
                    isbnContainer.style.display = 'none';
                    if (bookIdContainer) bookIdContainer.style.display = 'none';
                }
            }

            let currentImageBase64 = null;
            function handleImageSelect(event) {
                const file = event.target.files[0];
                if (file) {
                    // 2MB Limit check?
                    if (file.size > 2 * 1024 * 1024) {
                        alert("画像サイズが大きすぎます(2MB以下推奨)");
                        return;
                    }
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        currentImageBase64 = e.target.result;
                        document.getElementById('imagePreview').innerHTML = `<img src="${currentImageBase64}">`;
                    };
                    reader.readAsDataURL(file);
                }
            }

            /**
             * API Abstraction (GAS vs Mock)
             */
            class API {
                static getUrl() {
                    return "https://script.google.com/macros/s/AKfycbzymB9lco_JkhGR3DyF9qsKks_suS6Px2zK_pxeZ0-0pJMRvM0c-FEhOJ0ipBAPKO6z/exec";
                }

                static async getData() {
                    try {
                        const res = await fetch(this.getUrl(), {
                            method: 'POST',
                            // Using text/plain to bypass CORS preflight in standard GAS deployments
                            body: JSON.stringify({ action: 'getData' }),
                            headers: {
                                'Content-Type': 'text/plain;charset=utf-8'
                            }
                        });
                        const json = await res.json();
                        if (json.status === 'success') {
                            appState.disabledShelves = json.data.disabled || [];
                            return json;
                        }
                        throw new Error(json.message || "Failed to getData");
                    } catch (err) {
                        console.error("GAS API Error:", err);
                        return { status: 'error', data: { inventory: [], logs: [], disabled: [] } };
                    }
                }

                static async getLogs() {
                    try {
                        const res = await this.getData();
                        return res.data ? res.data.logs : [];
                    } catch (err) {
                        return [];
                    }
                }

                static async post(action, payload) {
                    try {
                        const res = await fetch(this.getUrl(), {
                            method: 'POST',
                            body: JSON.stringify({ action: action, payload: payload }),
                            headers: {
                                'Content-Type': 'text/plain;charset=utf-8' // CORS回避
                            }
                        });
                        return await res.json();
                    } catch (err) {
                        console.error("GAS Post Error:", err);
                        return { status: 'error' };
                    }
                }
            }

            /**
             * Map Modal
             */

function showImage(url) {
    const modal = document.getElementById('imageDisplayModal');
    const content = document.getElementById('imagePopupContent');
    content.innerHTML = `<img src="${url}" style="max-width:100%; max-height:80vh; border-radius:8px;">`;
    modal.classList.add('open');
}

function openMapModal() {
    document.getElementById('mapViewModal').classList.add('open');
}

// 余計な } は入れず、このまま閉じます
</script>
</body>
</html>